{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ITHelpDeskDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ITHelpDesk.Api",
    "Audience": "ITHelpDesk.Client",
    "ExpirationMinutes": 60
  },
  "TicketAttachments": {
    "MaxFileSizeBytes": 10485760,
    "MaxFilesPerUpload": 5,
    "MaxTotalSizePerTicketBytes": 52428800,
    "StorageRoot": "Uploads/TicketAttachments",
    "AllowedExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".pdf",
      ".txt",
      ".docx",
      ".xlsx"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}